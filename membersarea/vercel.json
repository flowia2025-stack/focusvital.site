{
  "headers": [
    { "source": "/(pages|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/pdf/(.*)", "headers": [{ "key": "Content-Disposition", "value": "attachment" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
